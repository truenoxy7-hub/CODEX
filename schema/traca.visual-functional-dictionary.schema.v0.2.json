{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traca.local/schema/traca.visual-functional-dictionary.schema.v0.2.json",
  "title": "TRAÇA visual-functional dictionary v0.2",
  "type": "object",
  "required": ["meta", "authority_order", "canonical_visual_reference", "sources", "evidence", "theme", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["id", "version", "status", "reported_inventory_evidence_count", "imported_inventory_evidence_count", "limitation"],
      "properties": {
        "id": { "type": "string" },
        "version": { "const": "0.2.0" },
        "status": { "type": "string" },
        "reported_inventory_evidence_count": { "type": "integer", "minimum": 0 },
        "imported_inventory_evidence_count": { "type": "integer", "minimum": 0 },
        "limitation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "authority_order": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "canonical_visual_reference": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["id", "concept", "label", "dictionary_ref", "source_refs", "evidence_refs", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^CVR_" },
          "concept": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "dictionary_ref": { "type": "string", "pattern": "^VF_" },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "status": { "const": "validated" }
        },
        "additionalProperties": false
      }
    },
    "sources": { "type": "array", "items": { "type": "object", "required": ["id", "authority", "status", "ref"] } },
    "evidence": { "type": "array", "items": { "type": "object", "required": ["id", "source_ref", "statement"] } },
    "theme": { "type": "object", "required": ["id", "status", "colors_are_semantic", "colors"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "concept", "definition", "type", "authority", "status", "source_refs", "evidence_refs", "visual", "semantic_refs", "notes"],
        "properties": {
          "id": { "type": "string" },
          "concept": { "type": "string" },
          "definition": { "type": "string" },
          "type": { "enum": ["primitive", "composition", "relational", "no_specific_glyph"] },
          "authority": { "type": "string" },
          "status": { "enum": ["validated", "candidate", "ambiguous"] },
          "source_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "visual": { "type": "object" },
          "semantic_refs": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
