{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traca.local/schema/traca.geometry.v0.3.json",
  "title": "TRAÇA — contracte geomètric general v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "meta",
    "court",
    "layout_policy",
    "zones",
    "spaces",
    "objects",
    "phases",
    "entities",
    "participant_states",
    "common_paths",
    "branches",
    "dependencies",
    "obligations",
    "diagnostics",
    "result",
    "traceability"
  ],
  "properties": {
    "$schema": {"const": "../../schema/traca.geometry.schema.v0.3.json"},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version",
        "case_id",
        "source_revision",
        "status",
        "authority",
        "composition_fingerprint",
        "canonical_promotion",
        "court_profile_ref"
      ],
      "properties": {
        "format": {"const": "TRACA_general_geometry"},
        "version": {"const": "0.3.0"},
        "case_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": ["string", "null"]},
        "status": {"enum": ["resolved", "partial", "blocked", "needs_input"]},
        "authority": {"enum": ["provisional_visual_policy", "legacy_canonical_adapter"]},
        "composition_fingerprint": {"type": "string", "minLength": 1},
        "canonical_promotion": {"const": false},
        "court_profile_ref": {"type": "string", "minLength": 1},
        "adapted_from": {
          "type": "object",
          "required": ["format", "version"],
          "properties": {
            "format": {"type": "string"},
            "version": {"type": "string"}
          },
          "additionalProperties": false
        }
      }
    },
    "court": {
      "type": "object",
      "required": ["width_m", "half_length_m", "goal", "markings", "view_box"],
      "properties": {
        "width_m": {"type": "number", "exclusiveMinimum": 0},
        "half_length_m": {"type": "number", "exclusiveMinimum": 0},
        "goal": {"type": "object"},
        "markings": {"type": "object"},
        "view_box": {"$ref": "#/$defs/view_box"}
      },
      "additionalProperties": false
    },
    "layout_policy": {
      "type": "object",
      "required": ["id", "version", "status", "coordinate_system", "attack_direction", "notes", "decisions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["provisional_render_policy", "deterministic"]},
        "coordinate_system": {"const": "metres_origin_goal_line_left"},
        "attack_direction": {"const": "negative_y"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/layout_decision"}}
      },
      "additionalProperties": false
    },
    "zones": {"type": "array", "items": {"type": "object"}},
    "spaces": {"type": "array", "items": {"$ref": "#/$defs/space"}},
    "objects": {"type": "array", "items": {"type": "object"}},
    "phases": {"type": "array", "items": {"type": "object"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "participant_states": {"type": "array", "items": {"$ref": "#/$defs/participant_state"}},
    "common_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "branches": {"type": "array", "items": {"type": "object"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "obligations": {"type": "array", "items": {"$ref": "#/$defs/obligation"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "obligations_total", "obligations_resolved", "obligations_pending", "incompatible_count"],
      "properties": {
        "status": {"enum": ["ready", "partial", "blocked", "needs_input"]},
        "obligations_total": {"type": "integer", "minimum": 0},
        "obligations_resolved": {"type": "integer", "minimum": 0},
        "obligations_pending": {"type": "integer", "minimum": 0},
        "incompatible_count": {"type": "integer", "minimum": 0}
      }
    },
    "traceability": {"type": "array", "items": {"$ref": "#/$defs/traceability"}}
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false
    },
    "view_box": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "items": false
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "layout_decision": {
      "type": "object",
      "required": ["id", "type", "target_ref", "status", "position", "source_refs"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "target_ref": {"type": "string"},
        "status": {"enum": ["preserved", "provisional_visual_policy"]},
        "position": {"$ref": "#/$defs/point"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "additionalProperties": false
    },
    "space": {
      "type": "object",
      "required": ["id", "kind", "relation", "anchor", "calculation_region", "render_policy", "source_refs"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"const": "relational_tactical_space"},
        "relation": {
          "type": "object",
          "required": ["type", "delimiter_refs"],
          "properties": {
            "type": {"type": "string"},
            "delimiter_refs": {"type": "array", "minItems": 2, "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "anchor": {"$ref": "#/$defs/point"},
        "calculation_region": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/point"}},
        "render_policy": {"const": "hidden"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["id", "kind", "label", "position", "status", "presence", "source_refs"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "label": {"type": "string"},
        "position": {"$ref": "#/$defs/point"},
        "state_ref": {"type": "string"},
        "status": {"const": "derived"},
        "presence": {"type": "string"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "additionalProperties": false
    },
    "participant_state": {
      "type": "object",
      "required": ["id", "participant_ref", "position", "status", "visibility", "source_refs"],
      "properties": {
        "id": {"type": "string"},
        "participant_ref": {"type": "string"},
        "state_key": {"type": ["string", "null"]},
        "state_id": {"type": ["string", "null"]},
        "phase_ref": {"type": ["string", "null"]},
        "phase": {"type": ["string", "null"]},
        "space_ref": {"type": ["string", "null"]},
        "functional_position_ref": {"type": ["string", "null"]},
        "position": {"$ref": "#/$defs/point"},
        "status": {"enum": ["current", "future", "past"]},
        "visibility": {"enum": ["normal", "control", "selected_alternative", "hidden"]},
        "authority": {"type": "string"},
        "layout_decision_ref": {"type": "string"},
        "alternative_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "additionalProperties": false
    },
    "segment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "start", "end"],
          "properties": {
            "type": {"const": "line"},
            "start": {"$ref": "#/$defs/point"},
            "end": {"$ref": "#/$defs/point"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "start", "control1", "control2", "end"],
          "properties": {
            "type": {"const": "cubic"},
            "start": {"$ref": "#/$defs/point"},
            "control1": {"$ref": "#/$defs/point"},
            "control2": {"$ref": "#/$defs/point"},
            "end": {"$ref": "#/$defs/point"}
          },
          "additionalProperties": false
        }
      ]
    },
    "functional_point": {
      "type": "object",
      "required": ["id", "role", "position"],
      "properties": {
        "id": {"type": "string"},
        "role": {"enum": ["waypoint", "commitment", "direction_break", "exit"]},
        "position": {"$ref": "#/$defs/point"}
      },
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "required": ["id", "kind", "action_type", "segments", "functional_points", "source_refs"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "action_type": {"enum": ["movement", "pass", "shot", "block"]},
        "action_ref": {"type": ["string", "null"]},
        "actor_ref": {"type": "string"},
        "opponent_ref": {"type": "string"},
        "blocked_defender_ref": {"type": "string"},
        "initial_space_ref": {"type": "string"},
        "target_space_ref": {"type": "string"},
        "from_state_ref": {"type": "string"},
        "to_state_ref": {"type": "string"},
        "ball_ref": {"type": "string"},
        "from_participant_ref": {"type": "string"},
        "to_participant_ref": {"type": "string"},
        "target_goal_ref": {"type": "string"},
        "anchor_mode": {"enum": ["symbol_perimeter", "none"]},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
        "functional_points": {"type": "array", "items": {"$ref": "#/$defs/functional_point"}},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["id", "trigger_ref", "effect_refs", "rule"],
      "properties": {
        "id": {"type": "string"},
        "trigger_ref": {"type": "string"},
        "effect_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "rule": {"const": "state_drives_geometry"}
      },
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": ["id", "kind", "action_ref", "target_ref", "required", "status", "geometry_refs", "source_refs"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "action_ref": {"type": ["string", "null"]},
        "target_ref": {"type": "string"},
        "required": {"type": "boolean"},
        "status": {"enum": ["resolved", "pending", "incompatible"]},
        "geometry_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "path", "message", "source_refs"],
      "properties": {
        "code": {"type": "string"},
        "severity": {"enum": ["info", "pending", "warning", "error"]},
        "path": {"type": "string"},
        "message": {"type": "string"},
        "action_ref": {"type": ["string", "null"]},
        "primitive_ref": {"type": "string"},
        "obligation_ref": {"type": "string"},
        "state_ref": {"type": "string"},
        "space_ref": {"type": "string"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "additionalProperties": false
    },
    "traceability": {
      "type": "object",
      "required": ["geometry_ref", "source_refs"],
      "properties": {
        "geometry_ref": {"type": "string", "minLength": 1},
        "action_ref": {"type": ["string", "null"]},
        "primitive_ref": {"type": "string"},
        "source_refs": {"$ref": "#/$defs/source_refs"}
      },
      "additionalProperties": false
    }
  }
}
