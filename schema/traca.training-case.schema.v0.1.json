{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traca.local/schema/traca.training-case.schema.v0.1.json",
  "title": "TRAÇA portable training case v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "metadata", "case", "description", "source_refs",
    "interpretation", "semantic_model", "spatial_model", "geometry_state", "derivations",
    "clarification_answers", "composition", "completeness",
    "generated_geometry", "coach_reference_geometry", "working_geometry",
    "base_visual_grammar", "case_visual_overrides", "corrections",
    "coach_observations", "validated_geometry", "validated_visual_grammar",
    "selected_alternatives", "validation", "knowledge_library"
  ],
  "properties": {
    "format": { "const": "TRACA_training_case" },
    "version": { "const": "0.5.0" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exported_at", "application", "canonical_promotion"],
      "properties": {
        "exported_at": { "type": "string", "format": "date-time" },
        "application": { "type": "string", "minLength": 1 },
        "canonical_promotion": { "const": false }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "description": { "type": "string" },
    "source_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "interpretation": { "type": "object" },
    "semantic_model": { "type": "object" },
    "spatial_model": { "type": "object" },
    "geometry_state": {
      "type": "object",
      "required": ["status", "resolver"],
      "properties": {
        "status": { "enum": ["unavailable", "generated", "coach_reference", "corrected", "validated", "stale"] },
        "resolver": { "type": ["string", "null"] }
      }
    },
    "derivations": { "type": "object" },
    "clarification_answers": { "type": "object" },
    "composition": {
      "type": "object",
      "required": ["status", "questions", "used_primitives", "unresolved"],
      "properties": {
        "status": { "type": "string" },
        "composition_status": { "type": "string" },
        "geometry_status": { "type": "string" },
        "questions": { "type": "array" },
        "used_primitives": { "type": "array", "items": { "type": "string" } },
        "unresolved": { "type": "array" },
        "coverage": { "type": ["object", "null"] },
        "plan": {
          "oneOf": [
            { "$ref": "traca.composition-plan.schema.v0.1.json" },
            { "type": "null" }
          ]
        },
        "preflight": { "type": ["object", "null"] }
      }
    },
    "completeness": { "type": "object" },
    "generated_geometry": { "type": ["object", "null"] },
    "coach_reference_geometry": { "type": ["object", "null"] },
    "working_geometry": { "type": ["object", "null"] },
    "base_visual_grammar": { "type": "object" },
    "case_visual_overrides": { "type": "array" },
    "corrections": {
      "type": "array",
      "items": { "$ref": "traca.correction-event.schema.v0.1.json" }
    },
    "coach_observations": { "type": "array" },
    "validated_geometry": { "type": ["object", "null"] },
    "validated_visual_grammar": { "type": ["object", "null"] },
    "selected_alternatives": { "type": "object", "additionalProperties": { "type": "string" } },
    "validation": {
      "type": "object",
      "required": ["status", "correction_count", "counts_by_layer", "preflight"],
      "properties": {
        "status": { "enum": ["pending", "changes_pending", "blocked", "validated_case"] },
        "correction_count": { "type": "integer", "minimum": 0 },
        "counts_by_layer": { "type": "object" },
        "preflight": { "type": ["object", "null"] }
      }
    },
    "knowledge_library": { "type": "object" }
  }
}
